--- Dataset copying from prem SQL server

{
    "name": "copyonpremDS",
    "properties": {
        "linkedServiceName": {
            "referenceName": "LSonpremisecopy",
            "type": "LinkedServiceReference"
        },
        "annotations": [],
        "type": "SqlServerTable",
        "schema": [],
        "typeProperties": {
            "schema": "dbo",
            "table": {
                "value": "@item().TABLE_NAME",
                "type": "Expression"
            }
        }
    },
