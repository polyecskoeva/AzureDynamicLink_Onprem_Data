}




--- Dataset copying to datalake bronze container

{
    "name": "todatalake",
    "properties": {
        "linkedServiceName": {
            "referenceName": "LStodataLake",
            "type": "LinkedServiceReference"
        },
        "annotations": [],
        "type": "Parquet",
        "typeProperties": {
            "location": {
                "type": "AzureBlobFSLocation",
                "fileName": {
                    "value": "@concat(item().TABLE_NAME, '.parquet')\n",
                    "type": "Expression"
                },
                "folderPath": {
                    "value": "@concat('bronze/', item().TABLE_NAME)\n\n",
                    "type": "Expression"
                }
            },
            "compressionCodec": "snappy"
        },
        "schema": []
    },
    "type": "Microsoft.DataFactory/factories/datasets"


    --- Copying LastrunTime from Azure SQL Database


    {
        "name": "AzureSqlTable1",
